# ============================================
# EXCHANGE API CONFIGURATION
# ============================================

# Binance (Recommended - most reliable)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Coinbase (Optional)
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# Kraken (Optional)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Bitget (Optional)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ============================================
# EMAIL NOTIFICATION CONFIGURATION
# ============================================

# Gmail App Password (NOT your main password)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECEIVER=recipient_email@gmail.com

# ============================================
# BOT CONFIGURATION
# ============================================

# Minimum profit percentage to execute trade (0.5 = 0.5%)
MIN_PROFIT_PERCENTAGE=0.5

# Price check interval in seconds (30 = check every 30 seconds)
PRICE_CHECK_INTERVAL=30

# Trading pair to monitor (e.g., BTC/USDT, ETH/USDT)
TRADING_PAIR=BTC/USDT

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/bot.log
